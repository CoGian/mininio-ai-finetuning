# Gemini API — required for data generation (data/generate.py)
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Gemini model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Langfuse — for LLM trace logging
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# HuggingFace — required for fine-tuning & model upload
HF_TOKEN=

# Weights & Biases — optional, for training metrics
WANDB_API_KEY=
WANDB_PROJECT=mininio-ai-finetuning

# Model identifiers (change if using different variants)
LFM_MODEL_NAME=unsloth/LFM2.5-1.2B-Instruct
GEMMA_MODEL_NAME=google/gemma-4-e2b-it
